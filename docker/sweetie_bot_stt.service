[Unit]
Description=Sweetie Bot STT
After=network.target

[Service]
Type=simple
WorkingDirectory=/app/sweetie_bot_stt
Environment=PATH=/opt/venv-main/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/venv-main/bin/gunicorn --bind 0.0.0.0:5004 --workers 1 --timeout 300 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
