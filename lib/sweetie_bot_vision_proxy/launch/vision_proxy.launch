<launch>
  <!--
    Vision federation front + visualizer (the new C++ proxy) + the py3.10 tracker-fuser.
    Replaces the old gasket+core. The provider container(s) are started MANUALLY (run_provider.py).
    Canonical LOCAL provider set (proto3 laptop) — includes object_openvino (person<->object HOLDING)
    and emotion_openvino (per-person emotion), both validated on proto3 req/foe footage 2026-07-01:
      run_provider.py -name sbprov -port 8080 \
        -providers face_openvino,pose_alphapose,gaze_openvino,hands_mediapipe,object_openvino,emotion_openvino
    object_openvino = CPU YOLOv4-tiny (pony_face/pony_body) -> the fuser's bind_objects_to_people stamps
    attributes['holding']='pony' on the holder + held_by on the object (tune SBVISION_HOLD_{TOUCH_IOU,
    WRIST_REACH,KP_THR}). emotion_openvino = OMZ emotions-recognition-retail-0003 -> attributes['emotion']
    (neutral|happy|sad|surprise|anger) per tracked face. Drop a provider to disable its attribute. The
    sweetie-vision-provider image was REBUILT with both baked in (2026-07-01); rebuild again via
    scripts/build_provider_image.sh if you add providers.
    Included by the deploy sweetie_bot_deploy/highlevel/vision.launch under the run_vision gate, so it
    comes up with flexbe_control.launch run_vision:=true.
  -->
  <arg name="provider_host"      default="127.0.0.1" />
  <arg name="provider_port"      default="8080" />
  <!-- optional REMOTE provider over wss (empty remote_host = local-only) -->
  <arg name="remote_host"        default="" />
  <arg name="remote_port"        default="" />
  <arg name="remote_insecure"    default="" />
  <arg name="remote_token"       default="" />
  <arg name="remote_max_staleness_ms" default="1500" />
  <arg name="fuser_host"         default="127.0.0.1" />
  <arg name="fuser_port"         default="9100" />
  <arg name="gst_port"           default="5000" />
  <arg name="ring_size"          default="60" />
  <arg name="image_topic"        default="/image_raw" />
  <!-- pre-draw pixels for dataset consumers (data recorder); image_topic keeps the HUD/boxes -->
  <arg name="clean_image_topic"  default="/vision_proxy/image_clean" />
  <arg name="image_frame_id"     default="camera_link_optical" />
  <arg name="detections_topic"   default="detections" />
  <arg name="skeleton_topic"     default="/hmi/vision_skeletons" />
  <arg name="gaze_topic"         default="/hmi/vision_gaze" />
  <arg name="camera_rotation_deg" default="0" />
  <!-- proto3 camera_link_optical is non-standard (x-left,y-up): negate x,y of published 3D positions -->
  <arg name="flip_optical_xy"    default="true" />
  <arg name="tracker"            default="human" />
  <!-- local link fatal on the real robot -> ERROR-grade, never-silent logs. false in sim. -->
  <arg name="provider_critical"  default="false" />

  <!-- py3.10 tracker-fuser SERVICE (ROS-free; bash wrapper execs the sbcore-venv). From sweetie_bot_vision. -->
  <node pkg="sweetie_bot_vision" type="vision_proxy_fuser_wrapper.sh" name="vision_proxy_fuser"
        output="screen" respawn="true">
    <env name="SBVISION_FUSER"  value="$(arg fuser_host):$(arg fuser_port)" />
    <env name="SBVISION_TRACKER" value="$(arg tracker)" />
  </node>

  <!-- C++ front transport + visualizer + ROS publisher (the single ROS face). -->
  <node pkg="sweetie_bot_vision_proxy" type="vision_proxy_node" name="vision_proxy" output="screen" respawn="true">
    <param name="pipeline" value="udpsrc port=$(arg gst_port) ! application/x-rtp,encoding-name=JPEG,payload=26 ! rtpjpegdepay ! jpegparse ! appsink name=sink emit-signals=true sync=false drop=true max-buffers=1" />
    <param name="provider_host"       value="$(arg provider_host)" />
    <param name="provider_critical"   value="$(arg provider_critical)" />
    <param name="provider_port"       value="$(arg provider_port)" />
    <param name="remote_host"         value="$(arg remote_host)" if="$(eval remote_host != '')" />
    <param name="remote_port"         value="$(arg remote_port)" if="$(eval remote_port != '')" />
    <param name="remote_insecure"     value="$(arg remote_insecure)" if="$(eval remote_insecure != '')" />
    <param name="remote_token"        value="$(arg remote_token)" if="$(eval remote_token != '')" />
    <param name="remote_max_staleness_ms" value="$(arg remote_max_staleness_ms)" />
    <param name="fuser_host"          value="$(arg fuser_host)" />
    <param name="fuser_port"          value="$(arg fuser_port)" />
    <param name="ring_size"           value="$(arg ring_size)" />
    <param name="image_topic"         value="$(arg image_topic)" />
    <param name="clean_image_topic"   value="$(arg clean_image_topic)" />
    <param name="image_frame_id"      value="$(arg image_frame_id)" />
    <param name="detections_topic"    value="$(arg detections_topic)" />
    <param name="camera_rotation_deg" value="$(arg camera_rotation_deg)" />
    <param name="flip_optical_xy"     value="$(arg flip_optical_xy)" />
    <param name="hud_font"            value="$(find sweetie_bot_vision_proxy)/fonts/ShareTechMono-Regular.ttf" />
  </node>

  <!-- hmi marker viz: /detections -> rviz skeleton + gaze MarkerArrays (moved out of the proxy). -->
  <node pkg="sweetie_bot_vision_hmi" type="vision_marker_node" name="vision_marker_node" output="screen" respawn="true">
    <param name="detections_topic" value="$(arg detections_topic)" />
    <param name="skeleton_topic"   value="$(arg skeleton_topic)" />
    <param name="gaze_topic"       value="$(arg gaze_topic)" />
  </node>
</launch>
