#
# LOOK AT
#
# DESCRIPTION
#
# Focus attention on given object presented in SWM.
#
# DECISION OPERATOR
#
# (<op> ^name @name@ ^substate look-at ^process-args <args>)
#   (<args> ^object <obj>)
#
# Look at <obj>. Action is preemeted if process is removed (deadline) or output cmd is aborted (controller switch, abrot request).
# If ^object is not visible it previous postion from SWM is used.
#
# PROCESS RESULT STATUSES
#
# * succeed -- look_at controller started and have been preemted by ^abort request or controller switch.
# * error -- can not comunicate controller or invald cmd
# * failed -- corresponding SWM object do not present
#
# SIDE EFFECTS
#
# Output link: 
#
# look-at 
#
# Predicates:
#
# * (^name looking-at ^object <obj> ^looking-at-proccess <proc>) --- object robot looking at is visible and is in center of viewfield
#

# ELABORATIONS
#
# deduce controlled/required resources
#

# mandatory required resource
sp {look-at*elaborate*controlled-resources-eyes
	(state <s> ^substate look-at)
-->
	(<s> ^controlled-resource eyes ^required-resource eyes)
}

# optional required resource
sp {look-at*elaborate*controlled-resources-head
	(state <s> ^substate look-at -^blocked-resource head)
-->
	(<s> ^controlled-resource head ^required-resource head)
}

sp {look-at*elaborate*controlled-resources-body
	(state <s> ^substate look-at ^args.aggresive -^blocked-resource body)
-->
	(<s> ^controlled-resource body ^required-resource body)
}

sp {look-at*elaborate*controlled-resources-head-eyes
	(state <s> ^substate look-at ^controlled-resource head eyes)
-->
	(<s> ^controlled-resource head-eyes)
}

#
# output link cmd recovering
# 

# exact command present at output link
sp {look-at*elaborate*my-look-at-cmd-head-or-eyes
	(state <s> ^substate look-at ^args.object <obj> ^controlled-resource {<<|head| |eyes|>> <res>} -^controlled-resource head-eyes ^io.output-link.look-at <cmd>)
	(<obj> ^label <label> ^type <type>)
	(<cmd> ^label <label> ^type <type> ^resource <res>)
-->
	(<s> ^my-look-at-cmd <cmd>)
}

sp {look-at*elaborate*my-look-at-cmd-head-and-eyes
	(state <s> ^substate look-at ^args.object <obj> ^controlled-resource head-eyes ^io.output-link.look-at <cmd>)
	(<obj> ^label <label> ^type <type>)
	(<cmd> ^label <label> ^type <type> ^resource head eyes)
-->
	(<s> ^my-look-at-cmd <cmd>)
}

#  command at output link is different
sp {look-at*elaborate*other-look-at-cmd
	(state <s> ^substate look-at ^io.output-link.look-at <cmd> -^my-look-at-cmd)
-->
	(<s> ^other-look-at-cmd <cmd>)
}

# look-at process start operators
sp {look-at*elaborate*add-process
	(state <s> ^substate look-at ^process-status pending ^operator <op> + ^process <proc>)
	(<op> ^name {<<|abort-look-at-cmd| |create-look-at-cmd|>>})
-->
	(<op> ^add-process <proc>)
}

# DECISION OPERATORS

# stop other look-at command if it is active
sp {look-at*propose*abort-look-at-cmd
	(state <s> ^substate look-at  ^other-look-at-cmd <cmd>)
	(<cmd> -^abort)
-->
	(<s> ^operator <op> +)
	(<op> ^name abort-look-at-cmd ^type automatic ^parent <cmd> ^attribute abort ^link-value graceful_stop)
}

# wait until look-at command is stopped
#sp {look-at*propose*abort-look-at-cmd-wait
#	(state <s> ^substate look-at ^other-look-at-cmd <cmd>)
#	(<cmd> ^abort)
#-->
#	(<s> ^operator <op> +)
#	(<op> ^name wait-abort-look-at-cmd ^substate wait)
#}

# start look-at cmd
sp {look-at*propose*start-look-at-cmd
	(state <s> ^substate look-at ^args.object <obj> -^other-look-at-cmd -^my-look-at-cmd ^process <proc>)
	(<obj> ^label <label> ^type <type>)
-->
	(<s> ^operator <op> +)
	(<op> ^name create-look-at-cmd  ^type automatic ^add-output-command look-at ^output-command-args <cmd>)
	(<cmd> ^label <label> ^type <type> ^process <proc>)
	(<op> ^log (concat |LookAt: issue look-at cmd on | <label> |, | <type> (crlf)))
}

sp {look-at*elaborate*start-look-at-cmd-resources
	(state <s> ^substate look-at ^operator <op> + ^controlled-resource {<<|head| |eyes|>> <res>})
	(<op> ^name create-look-at-cmd ^output-command-args <cmd>)
-->
	(<cmd> ^resource <res>)
}

# start process if exicting look-at cmd is reused
sp {look-at*propose*start-process-old-command
	(state <s> ^substate look-at ^my-look-at-cmd <cmd> ^process <proc>)
	(<cmd> ^process {<> <proc> <proc-old>} -^abort)
-->
	(<s> ^operator <op> +)
	(<op> ^name reuse-lookat-cmd ^type automatic ^add-process <proc>)
	(<op> ^finish-status succeed ^finish-process <proc-old>)
	(<op>  ^parent <cmd> ^attribute proccess ^remove-value <proc-old> ^link-value <proc>)
}

# wait look-at cmd
#sp {look-at*propose*look-at-cmd-wait
#	(state <s> ^substate look-at ^process-status active ^my-look-at-cmd)
#-->
#	(<s> ^operator <op> +)
#	(<op> ^name wait-look-at-cmd ^substate wait)
#}

# COGNITION

# terminate process if output cmd is finished
sp {look-at*propose*finish-process
	(state <s> ^bottom-state 1 ^io.output-link <ol>)
	(<ol> ^look-at <cmd>)
	(<cmd> ^status <status> ^process <proc>)
-->
	(<s> ^operator <op> +, =)
	(<op> ^name look-at-finish-process ^cmd <cmd> ^type automatic cognition ^finish-status <status> ^finish-process <proc>)
	(<op> ^parent <ol> ^attribute look-at ^remove-value <cmd>)
	(<op> ^log |LookAt: complete behavior with status | <status> (crlf))
}

# remove cmd if process is finished
sp {look-at*propose*finish-process-abort-cmd
	(state <s> ^bottom-state 1 ^io.output-link.look-at <cmd> ^beliefs <b>)
	(<cmd> -^abort ^process <proc>)
   	(<b> -^process <proc>) 
-->
	(<s> ^operator <op> +, =)
	(<op> ^name look-at-finish-process-abort-cmd ^type automatic cognition ^parent <cmd> ^attribute abort ^link-value graceful_stop)
}

# COGNITION ELABOARTIONS

sp {look-at*elaborate*process-cmd
	(state <s> ^top-state 1 ^beliefs <b> ^io.output-link.look-at <cmd>)
	(<cmd> ^process <proc> ^resource <res>)
-->
	(<proc> ^controlled-resource <res>)
}

# detect "object in the center" situation if head is controlled
sp {look-at*elaborate*looking-at-head 
	(state <s> ^top-state 1 ^beliefs <b>)
	(<b> ^process <proc>)
	(<proc> ^substate look-at ^object <obj> ^controlled-resource head)
	(<obj> ^input-link <il>)
	(<il> ^visible now ^yaw-head center)
-->
	(<b> ^predicate <pred>)
	(<pred> ^name looking-at ^object <obj> ^focusing-process <proc>)
}

sp {look-at*elaborate*looking-at-eyes
	(state <s> ^top-state 1 ^beliefs <b>)
	(<b> ^process <proc>)
	(<proc> ^substate look-at ^object <obj> -^controlled-resource head)
	(<obj> ^input-link <il>)
	(<il> ^visible now ^yaw-eyes center)
-->
	(<b> ^predicate <pred>)
	(<pred> ^name looking-at ^object <obj> ^focusing-process <proc>)
}

