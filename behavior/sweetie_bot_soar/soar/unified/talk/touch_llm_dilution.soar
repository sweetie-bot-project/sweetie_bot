# LLM-diluted touch reactions (DRAFT - review before sourcing).
#
# The canned touch rules in talk_simple.soar propose verbolize with fixed ^text phrases and
# indifferent preference (+, =). These siblings propose verbolize-llm for the SAME trigger with
# the SAME indifference -> the decision procedure picks canned vs LLM at random (~50/50).
# To change the ratio, add a gate like (^io.input-link.rand < 0.35) to these rules.
#
# The ^text here is a stage direction the LLM reacts to (the persona knows the touch-sensor
# semantics: nose/cheek/temple = delight, nose bridge/forehead = too close to the camera).
# Emotion comes from the LLM reply and drives the animation tag as usual.

# boop -> LLM
sp {talk-llm*propose*touch-nose-llm
	(state <s> ^substate talk-llm  -^talking ^lang <lang> ^io.input-link.touch <touch> ^most-recent-event.object <obj>)
	(<touch> ^pressed nose)
-->
	(<s> ^operator <op> +, =)
	(<op> ^name rule-answering-on-event ^substate verbolize-llm ^process-args <args>)
	(<args> ^object <obj> ^topic touch ^lang <lang> ^text |*boops your nose*|)
	(<args> ^result <res>)
	(<res> ^status succeed ^print (concat |SPECIFIC: TOUCH LLM.| (crlf)))
}

# forehead (nose bridge, next to camera) -> LLM
sp {talk-llm*propose*touch-forehead-llm
	(state <s> ^substate talk-llm  -^talking ^lang <lang> ^io.input-link.touch <touch> ^most-recent-event.object <obj>)
	(<touch> ^pressed forehead)
-->
	(<s> ^operator <op> +, =)
	(<op> ^name rule-answering-on-event ^substate verbolize-llm ^process-args <args>)
	(<args> ^object <obj> ^topic touch ^lang <lang> ^text |*presses on your nose bridge, right next to your camera*|)
	(<args> ^result <res>)
	(<res> ^status succeed ^print (concat |SPECIFIC: TOUCH LLM.| (crlf)))
}

# cheek / temple scratch -> LLM
sp {talk-llm*propose*touch-cheek-or-temple-llm
	(state <s> ^substate talk-llm  -^talking ^lang <lang> ^io.input-link.touch <touch> ^most-recent-event <ev>)
	(<touch> ^pressed {<<|cheek_left| |cheek_right| |temple_left| |temple_right|>> <spot>})
	(<ev> ^object <obj>)
-->
	(<s> ^operator <op> +, =)
	(<op> ^name rule-answering-on-event ^substate verbolize-llm ^process-args <args>)
	(<args> ^object <obj> ^topic <spot> ^lang <lang> ^text (concat |*gently scratches your | <spot> |*|))
	(<args> ^result <res>)
	(<res> ^status succeed ^print (concat |SPECIFIC: TOUCH LLM.| (crlf)))
}
