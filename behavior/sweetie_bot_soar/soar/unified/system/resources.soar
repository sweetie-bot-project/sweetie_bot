#
# RESOURCES HANDLING
#
# STATE LEVEL
#
# Each process state may have following agumentation:
#   (<s> ^blocked-resource <name>)
#        Resources is already acquired by process with  greater precedence. 
#        This WME is deduced automatically.
#   (<s> ^reserved-resource <name>)
#        Resource is reserved for subprocesses of current process. It will be blocked for other processes which have lower precendence then process reserved recourse.
#        This WME is added by process state elaborations.
#   (<s> ^required-resource <name>)
#        Resource is required by current process. 
#        This WME is added by process state elaborations.
#        
# * Resource conflict: the same process have blocked and required/reserved resource in its state.
# * Conflict resolution:
#   - If current process is pending (operator seleced but procces prediacte is not created and no effor to achive goal is taken) 
#     then operator which produced state is prohibited. 
#   - If current process is active (process predicate have been already created) then procces 
#     is finished with status 'conflict'.
# * Conflict avoidance and gracefull process termination: possible confict may be detected by checking ^blocked-resoucse WME.
#
# OPERATOR LEVEL
#
# Substate operator with additional attributes:
#
# (<op> ^name @name@ ^substate @substate@ ^process-args <args> ^required-resource <res1> <res2>)
#
# * If any resource is blocked then operator prohibited.
# * Process predicate is augumanted with corresponding ^required-resource attributes and corresponding resources are blocked in substate.
# * This method is the best for states which utilizes resources-agnostic low-level states (flexbe, set-operational) to create assotiation with resourse.
#

# ELABORATIONS

#
# determine resource set
#

# elaborate blocked resource in subprocess state
sp {process*elaborate*blocked-resource-common
	(state <s> ^superstate <ss>)
	(<ss> ^{<<|blocked-resource| |required-resource|>>} <res>)
--> 
	(<s> ^blocked-resource <res>)
}

# block resources if selected process is not inside subtree in witch resource was reserved
# in this case resource would not be reserved in state of process parent
sp {process*elaborate*reserved-resource-to-blocked
	(state <s> ^substate ^reserved-resource <res> ^superstate <ss>
	(<ss> ^sustate scheduling ^operator <op>)
	(<op> ^type scheduling ^parent-substate <ps>)
	(<ps> -^reserved-resource <res>)
-->
	(<s> ^blocked-resource <res>)
}

# propagate reserved resources by deafult
sp {process*elaborate*reserved-resource-non-general
	(state <s> ^superstate <ss> -^required-resource <res> -^blocked-resource <res>)
	(<ss> ^reserved-resource <res>)
-->
	(<s> ^reserved-resource <res>)
}

#
# State-level resources support
#

# reject pending process if required/reserved resource is blocked
sp {process*prefer*prohibit-resource-conflict
	(state <s> ^process-status pending ^blocked-resource <res> ^{<<|required-resource| |reserved-resource|>>} <res> ^superstate <ss> ^substate <s-name>)
	(<ss> ^operator <op> ^substate <ss-name>)
	(<op> ^name <name>)
-->
	(<ss> ^operator <op> ~)
	(log 1 (concat |REJECT superstate operator | <op> | | <name> | in | <ss> | (| <ss-name> |) from | <s> | (| <s-name> |) for | <res> (crlf)))
}

# terminate active process if required/reserved resource is blocked
sp {process*propose*terminate-resource-conflict
	(state <s> ^process-status active ^blocked-resource <res> ^{<<|required-resource| |reserved-resource|>>} <res> ^substate <substate> ^process <proc>)
-->
	(<s> ^operator <op> +, =)
	(<op> ^name resources-conflict-finish-process ^type decision-enter automatic ^finish-process <proc> ^finish-status conflict)
}

#
# Operator-level resource support
#

# reject operators which requires blocked resource
sp {process*prefer*prohibit-operator-by-resource
	(state <s> ^blocked-resource <res> ^operator <op> +)
	(<op> ^required-resource <res> ^name <name>)
-->
	(<s> ^operator <op> ~)
	(log 1 (concat |REJECT state operator | <op> | | <name> | in | <s> (crlf)))
}

# add to process predicate resources supplied as operator attributes
sp {process*apply*add-required-resource
	(state <s> ^substate ^process <proc> ^superstate.operator.required-resource <res>)
-->
	(<proc> ^required-resource <res>)
}

# propagate resources from process to state
sp {process*elaborate*add-state-resource-attr
	(state <s> ^substate ^process.required-resource <res>)
-->
	(<s> ^required-resource <res>)
}

