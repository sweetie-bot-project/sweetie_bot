# PREFERENCES 

#
# OPERATOR PREFERENCES 
#
# Types:
# - system
# - cognition
# - decision-enter
# - decision
# - decision-exit
#

# Derive operators priorities based on type.

sp {elaborate*type-priorioty-system
	(state <s> ^operator <o> +)
	(<o> ^type system)
-->
	(<s> ^operator <o>  =)
	(<o> ^type-priority 4)
}

sp {elaborate*type-priority-cognition
	(state <s> ^operator <o> +)
	(<o> ^type cognition)
-->
	(<s> ^operator <o>  =)
	(<o> ^type-priority 3)
}

sp {elaborate*type-priority-decision-enter
	(state <s> ^operator <o> +)
	(<o> ^type decision-enter)
-->
	(<o> ^type-priority 2)
}

sp {elaborate*type-priority-decision
	(state <s> ^operator <o> +)
	(<o> ^type decision)
-->
	(<o> ^type-priority 1)
}

sp {elaborate*type-priorioty-decision-exit
	(state <s> ^operator <o> +)
	(<o> ^type decision-exit)
-->
	(<o> ^type-priority 0)
}

# Use priority to add preferences

sp {prefer*type-priority
   (state <s> ^operator <o1> +  ^operator {<> <o1> <o2>} +)
   (<o1> ^type-priority <pri1>)
   (<o2> ^type-priority {< <pri1>})
-->
   (<s> ^operator <o1> > <o2>)
}

sp {prefer*type-priority-lt-default
   (state <s> ^operator <o1> +  ^operator {<> <o1> <o2>} +)
   (<o1> -^type-priority)
   (<o2> ^type-priority {< 1})
-->
   (<s> ^operator <o1> > <o2>)
}

sp {prefer*type-priority-gt-default
   (state <s> ^operator <o1> +  ^operator {<> <o1> <o2>} +)
   (<o1> -^type-priority)
   (<o2> ^type-priority {> 1})
-->
   (<s> ^operator <o1> < <o2>)
}

# DRIVED OPERATOR PREFERENCES

# opertors with greater importance are better
sp {prefer*importance
   (state <s> ^operator <o1> +  ^operator { <o2> <> <o1> } +)
   (<o1> ^importance <i1>)
   (<o2> ^importance { <i2> > <i1> })
-->
   (<s> ^operator <o2> > <o1>)
}

# derive importance from drive
sp {elaborate*driver-operator-importance
	(state <s> ^operator <op> + ^mem.drive <d>)
	(<op> ^drive <name>)
	(<d> ^name <name> ^importance <i>)
-->
   (<op> ^importance <i>)
}
