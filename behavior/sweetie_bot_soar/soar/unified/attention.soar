#
# ATTENTION MODULE
#
# DESCRIPTION
#
# Focus attention on one of visible object. State no change if not point to focus attention.
# Attention switch is based on distance, object time and apperance.
#
# DECISION OPERATOR
#
# (<op> ^name @name@ ^substate attention)
#
# PROCESS RESULT STATUSES
#
# Does not finish corresponding process or set its status. Use ^deadline-time attribute to limit it duration.
#
# SIDE EFFECTS
#
# Output link: 
#
# * flexbe behavior
#

# UTILITY ELABORATION

# produce evaluation frames: use type, distance-head and perceive-begin attributes for visible objects
sp {attention*elaborate*evaluation-frames
	(state <s> ^substate attention ^beliefs.object <obj>)
	(<obj> ^type <type> ^input-link <il>)
	(<il> ^visible now ^yaw-body {<<|left| |center| |right|>>} ^perceive-begin <p-time> ^distance-head <d-head>)
-->
	(<s> ^evaluation-frame <e>)
	(<e> ^object <obj> ^type <type> ^perceive-begin <p-time> ^distance-head <d-head>)
}

# parameters, utility map for different attributes values
sp {attention*elaborate*preferences-and-utility
	(state <s> ^substate attention)
-->
	(<s> ^focus-reconsider-time 10.0)
	(<s> ^attempt-to-focus-time 3.0)
	(<s> ^preference <p1> <p2> <p3>)
	(<p1> ^attribute type ^map <m1> ^utility utilityA ^default -100)
	(<m1> ^human 20 ^pony 10 ^speech 30 ^sound 10)	
	(<p2> ^attribute distance-head ^map <m2> ^utility utilityB ^default 0)
	(<m2> ^close 200 ^near 50)	
	(<p3> ^attribute perceive-begin ^map <m3> ^utility utilityC ^default 0)
	(<m3> ^now 100 ^recently 50)	
}

# ELABORATIONS 

# calculate reconsider decision threshold 
sp {attention*elaborate*reconsider-decision-utility-threshold
	(state <s> ^substate attention ^focusing-attention <proc> ^evaluation-frame <eval>)
	(<proc> ^object <obj>)
	(<eval> ^object <obj> ^utility <utility>)
-->
	(<s> ^decision-reconsider-utility-threshold (+ <utility> 100))
}

# DECISION OPERATORS

# look at the object
sp {attention*propose*look-at-new-atention-focus
	(state <s> ^substate attention -^focusing-attention ^evaluation-frame <en> ^process <sproc> ^beliefs <b>)
	(<en> ^object <obj> ^utility <utility>)
	-{
	  (<b> ^predicate <pf>)
	  (<pf> ^name attention-focus-failed ^object <obj>)
	}
	(<s> ^focus-reconsider-time <reconsider-time> ^attempt-to-focus-time <focus-timeout>)
-->
	(<s> ^operator <op> +, = <utility>)
	(<op> ^name focusing-attention ^substate look-at ^process-args <a>)
	(<a> ^object <obj> ^deadline-time <reconsider-time>) 
}

# continue looking at selected object
sp {attention*propose*look-at-attention-focus
	(state <s> ^substate attention ^focusing-attention <proc>)
	(<proc> ^object <obj>)
-->
	(<s> ^operator <op> +, =)
	(<op> ^name continue-focusing-attention ^substate look-at ^process-link <proc>)
}

# conside new attention focus if its utility is greater then threshold
sp {attention*propose*switch-atention-focus
	(state <s> ^substate attention ^focusing-attention <proc-old> ^evaluation-frame <eval-new> ^decision-reconsider-utility-threshold <threshold> ^beliefs <b>)
	(<eval-new> ^utility {>= <threshold> <utility>} ^object <obj>)
	-{
	  (<b> ^predicate <pf>)
	  (<pf> ^name attention-focus-failed ^object <obj>)
	}
	(<s> ^focus-reconsider-time <reconsider-time> ^attempt-to-focus-time <focus-timeout>)
-->
	(<s> ^operator <op> +, = <utility>)
	(<op> ^name focusing-attention ^substate look-at ^process-args <a>)
	(<a> ^object <obj> ^deadline-time <reconsider-time>) 
}

# PREFERENCES

# prefer switch attention over look at
sp {attention*prefer*switch
	(state <s> ^substate attention ^operator <op1> + ^operator {<> <op1> <op2>} +)
	(<op1> ^name focusing-attention -^type continue-subprocess)
	(<op2> ^name continue-focusing-attention)
-->
	(<s> ^operator <op1> > <op2>)
}

# FAILED-FOCUS LATCH

# A focusing-attention process that terminates with status failed (look-at fast-fail: the
# SWM store entry is gone while the belief WME persists, unsafe target, controller reject)
# must not be re-proposed for the same object on the next decide cycle: live 2026-07-14 the
# fast-fail loop ran at ~4/s for 5.5 min and starved the answer machinery. The latch is a
# per-object belief predicate with a 15 s deadline (cleared by the native predicate
# deadline sweep, log seam "DEADLINE predicate attention-focus-failed"), so a transient
# failure costs an object at most 15 s of attention, never a permanent blacklist.
# ^reason rejected (process evicted by the resource arbiter before running) must NOT
# latch: resource churn is not the object's fault.
sp {attention*propose*attention-focus-failed-latch
	(state <s> ^substate attention ^beliefs <b>)
	(<b> ^event <ev>)
	(<ev> ^name focusing-attention ^reason terminated -^reason rejected ^status failed ^process.object <obj>)
	-{
	  (<b> ^predicate <pf>)
	  (<pf> ^name attention-focus-failed ^object <obj>)
	}
-->
	(<s> ^operator <op> +, =)
	(<op> ^name attention-focus-failed-latch ^type cognition automatic ^print (concat |SPECIFIC: ATTENTION-FOCUS-FAILED.| (crlf)))
	(<op> ^add-predicate <pred-new>)
	(<pred-new> ^name attention-focus-failed ^object <obj> ^deadline-time 15.0)
}

# if every candidate object is latched propose an explicit wait: the attention substate
# stays selected by its parent while evaluation frames exist, and an operator-less
# substate cascades state-no-change impasses
sp {attention*propose*wait-all-focus-candidates-latched
	(state <s> ^substate attention -^focusing-attention ^evaluation-frame ^beliefs <b>)
	-{
	  (<s> ^evaluation-frame <en>)
	  (<en> ^object <obj>)
	  -{
	    (<b> ^predicate <pf>)
	    (<pf> ^name attention-focus-failed ^object <obj>)
	  }
	}
-->
	(<s> ^operator <op> +, =)
	(<op> ^name waiting-attention-focus ^substate wait)
}

# the latch must win the decision slot immediately: focusing-attention proposals carry
# numeric utility preferences and value-based exploration starves a plain indifferent
# cognition operator (observed: 61 fast-fails before the latch was first selected)
sp {attention*prefer*failed-latch
	(state <s> ^substate attention ^operator <op1> + ^operator {<> <op1> <op2>} +)
	(<op1> ^name attention-focus-failed-latch)
	(<op2> ^name <<|focusing-attention| |continue-focusing-attention|>>)
-->
	(<s> ^operator <op1> > <op2>)
}
