#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Vision rviz marker node (hmi). Subscribes the vision /detections (DetectionArray) and publishes the
rviz visualization the C++ vision_proxy used to emit itself:

* /hmi/vision_skeletons - per-body COCO-17 skeleton (LINE_LIST bones + SPHERE_LIST joints), per-track
  colour, built from Detection.keypoints_3d.
* /hmi/vision_gaze      - per-face gaze ARROW (green DRAWN / orange WANDERING) + a DRAWN/WANDERING text
  label, reconstructed from the gaze_pitch/gaze_yaw/attention_state attributes + pose.

The proxy is now a pure data bridge: it publishes /detections (with keypoints_3d) already in the robot's
camera_link_optical convention (the x,y optical flip is applied there), so this node does NO frame flip
for positions. The gaze DIRECTION is rebuilt here from angles in the optical convention, so only that
vector gets x,y negated to match the (already-flipped) positions.
"""
import colorsys
import math

import rospy
from std_msgs.msg import ColorRGBA, Header
from geometry_msgs.msg import Point, Pose, Quaternion
from visualization_msgs.msg import Marker, MarkerArray
from sweetie_bot_text_msgs.msg import DetectionArray

# COCO-17 skeleton bones (keypoint index pairs).
COCO17_EDGES = [(5, 7), (7, 9), (6, 8), (8, 10), (5, 6), (5, 11), (6, 12), (11, 12),
                (11, 13), (13, 15), (12, 14), (14, 16), (0, 1), (0, 2), (1, 3), (2, 4), (0, 5), (0, 6)]

_GAZE_COLORS = {"DRAWN": (0.1, 1.0, 0.2), "WANDERING": (1.0, 0.55, 0.0)}
_GAZE_LEN = 0.4   # arrow length (m)
_FLIP_GAZE_DIR = True   # negate gaze-direction x,y to match the proxy's flipped positions


def _track_color(track_id, alpha=1.0):
    h = (int(track_id) * 0.618033988749895) % 1.0
    r, g, b = colorsys.hsv_to_rgb(h, 0.85, 1.0)
    return ColorRGBA(r, g, b, alpha)


def _valid(p):
    """A keypoint is present iff finite and not collapsed to the origin (absent joints arrive as 0/NaN)."""
    if not (math.isfinite(p.x) and math.isfinite(p.y) and math.isfinite(p.z)):
        return False
    return abs(p.z) > 1e-3 or abs(p.x) > 1e-3 or abs(p.y) > 1e-3


def _attrs(det):
    return {k: v for k, v in zip(det.attribute, det.value)}


def to_skeleton_markers(msg):
    arr = MarkerArray()
    for d in msg.detections:
        if d.type != "body" or len(d.keypoints_3d) < 17:
            continue
        kp = d.keypoints_3d
        tid = int(d.id)
        col = _track_color(tid)
        bones = Marker(header=d.header, ns="vision_skeleton", id=tid, type=Marker.LINE_LIST,
                       action=Marker.ADD, color=col, lifetime=rospy.Duration(0.5))
        bones.scale.x = 0.02
        bones.pose.orientation.w = 1.0
        for a, b in COCO17_EDGES:
            if a < len(kp) and b < len(kp) and _valid(kp[a]) and _valid(kp[b]):
                bones.points.append(kp[a])
                bones.points.append(kp[b])
        joints = Marker(header=d.header, ns="vision_skeleton_joints", id=tid, type=Marker.SPHERE_LIST,
                        action=Marker.ADD, color=col, lifetime=rospy.Duration(0.5))
        joints.scale.x = joints.scale.y = joints.scale.z = 0.045
        joints.pose.orientation.w = 1.0
        for p in kp:
            if _valid(p):
                joints.points.append(p)
        if bones.points or joints.points:
            arr.markers.append(bones)
            arr.markers.append(joints)
    return arr


def _gaze_dir(pitch_deg, yaw_deg):
    """Unit gaze vector (optical convention) from (pitch, yaw) degrees: looking at the camera = -Z;
    yaw>0 -> image-right (+X), pitch>0 -> up (-Y). Mirrors providers.gaze_openvino.gaze_to_angles."""
    p, y = math.radians(pitch_deg), math.radians(yaw_deg)
    g = [math.sin(y) * math.cos(p), -math.sin(p), -math.cos(y) * math.cos(p)]
    if _FLIP_GAZE_DIR:
        g[0], g[1] = -g[0], -g[1]
    return g


def to_gaze_markers(msg):
    arr = MarkerArray()
    for d in msg.detections:
        if d.type != "face":
            continue
        a = _attrs(d)
        if "gaze_yaw" not in a or "gaze_pitch" not in a:
            continue
        try:
            g = _gaze_dir(float(a["gaze_pitch"]), float(a["gaze_yaw"]))
        except (TypeError, ValueError):
            continue
        state = a.get("attention_state", "")
        r, gg, b = _GAZE_COLORS.get(state, (0.6, 0.6, 1.0))
        col = ColorRGBA(r, gg, b, 1.0)
        tid = int(d.id)
        p = d.pose.position
        arrow = Marker(header=d.header, ns="vision_gaze", id=tid, type=Marker.ARROW, action=Marker.ADD,
                       color=col, lifetime=rospy.Duration(0.5))
        arrow.scale.x, arrow.scale.y, arrow.scale.z = 0.015, 0.04, 0.06  # shaft dia, head dia, head len
        arrow.pose.orientation.w = 1.0
        arrow.points.append(Point(p.x, p.y, p.z))
        arrow.points.append(Point(p.x + _GAZE_LEN * g[0], p.y + _GAZE_LEN * g[1], p.z + _GAZE_LEN * g[2]))
        label = Marker(header=d.header, ns="vision_gaze_label", id=tid, type=Marker.TEXT_VIEW_FACING,
                       action=Marker.ADD, color=col, lifetime=rospy.Duration(0.5))
        label.scale.z = 0.1
        label.pose.orientation.w = 1.0
        # optical-frame +Y is down, but positions are flipped to the robot frame (y up) -> raise = +Y
        label.pose.position = Point(p.x, p.y + 0.18, p.z)
        label.text = state if state else "?"
        arr.markers.append(arrow)
        arr.markers.append(label)
    return arr


def main():
    rospy.init_node("vision_marker_node")
    topic = rospy.get_param("~detections_topic", "detections")
    skel_pub = rospy.Publisher(rospy.get_param("~skeleton_topic", "/hmi/vision_skeletons"),
                               MarkerArray, queue_size=5)
    gaze_pub = rospy.Publisher(rospy.get_param("~gaze_topic", "/hmi/vision_gaze"),
                               MarkerArray, queue_size=5)

    def cb(msg):
        skel_pub.publish(to_skeleton_markers(msg))
        gaze_pub.publish(to_gaze_markers(msg))

    rospy.Subscriber(topic, DetectionArray, cb, queue_size=5)
    rospy.loginfo("vision_marker_node: %s -> /hmi/vision_skeletons + /hmi/vision_gaze", topic)
    rospy.spin()


if __name__ == "__main__":
    main()
